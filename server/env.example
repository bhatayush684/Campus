# Server Configuration
PORT=3001
NODE_ENV=development

# Firecrawl API Key (Get from https://www.firecrawl.dev/)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# Google AI API Key for RAG (Gemini)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here
GOOGLE_AI_MODEL=gemini-3-flash-preview,gemini-3.1-flash-lite
# Optional comma-separated fallback models
# GOOGLE_AI_MODEL=gemini-3-flash-preview,gemini-3.1-flash-lite

# Optional OpenAI fallback. Never commit the key.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Walchand College Website
WCE_BASE_URL=https://walchandsangli.ac.in
WCE_BASE_URLS=https://walchandsangli.ac.in,https://walchandsangli.com,https://walchandsangli.in
SCRAPE_MAX_DEPTH=1
SCRAPE_MAX_PAGES=20
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
